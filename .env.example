# EventPass API — copy to .env and fill in. Never commit the real file.

PORT=8787
# Public origin PayBox will fetch the x402 resource from (must be https in production).
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Signs ticket QR codes. REQUIRED on a deployed instance — the server refuses to
# start without it rather than fall back to a shared value. Generate 32 bytes:
#   openssl rand -hex 32
# Rotating this invalidates every previously issued ticket. Locally you may leave
# it unset: the server then mints a random per-process secret, and tickets simply
# stop verifying after a restart.
TICKET_SECRET=

# Organizer check-in. Without it, /v1/organizer/* returns 503 and admits nobody.
ORGANIZER_KEY=replace-with-a-long-random-string

# How long a reservation holds inventory before the sweeper releases it.
ORDER_HOLD_MINUTES=15

# --- storage -----------------------------------------------------------------
# Set DATABASE_URL to use PostgreSQL (required for any serverless deployment:
# without it, each instance keeps its own inventory and two instances would
# oversell the same seat).
# Leave it unset to use the in-process store, which is fine for local demos but
# loses every order, ticket and inventory change when the process restarts.
DATABASE_URL=
# Run `pnpm migrate` after setting this; it is idempotent and never resets sold
# inventory. Supabase works unchanged — use the pooled connection string.

# TLS for DATABASE_URL. Default: off for localhost, encrypted for any other host.
#   verify  -> also check the certificate chain (do this in production once you
#              have confirmed the provider's CA is trusted)
#   disable -> no TLS
# DATABASE_SSL=verify

# Connections per instance. Serverless defaults to 1, a long-lived process to 10.
# PG_POOL_MAX=

# --- x402 payment (required for real purchases) -----------------------------
# The Base address that receives USDC. Payments settle here.
X402_PAY_TO=0xYourBaseReceivingAddress

# A facilitator that supports USDC on Base MAINNET (eip155:8453).
# x402.org's public facilitator is testnet-oriented; mainnet typically means the
# Coinbase CDP facilitator, which needs API keys.
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Optional bearer tokens, if your facilitator requires auth on each call.
X402_VERIFY_TOKEN=
X402_SETTLE_TOKEN=

# CDP facilitator authentication. Set BOTH to use the Coinbase facilitator; the
# server signs a short-lived EdDSA JWT per request. If neither this pair nor a
# static token above is configured, the pay endpoint fails closed (503) rather
# than calling the facilitator anonymously.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Local/test only: permits facilitator calls carrying no credential at all.
# Leave unset in production. This is an explicit opt-in, never a default.
X402_ALLOW_UNAUTHENTICATED_FACILITATOR=

# 1 or 2. PayBox sends v2, so 2 is the default: one CAIP-2 (eip155:8453)
# requirement using the v2 `amount` field and the USDC EIP-712 domain in `extra`.
# Set 1 for a legacy v1 client, which gets the "base" spelling and
# `maxAmountRequired`. The gate accepts PAYMENT-SIGNATURE or X-PAYMENT either
# way, and a v2 payload's `accepted` terms are forwarded to the facilitator
# unchanged as `paymentRequirements`.
X402_VERSION=2
